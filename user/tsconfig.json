{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "baseUrl": ".",
  "paths": {
    "@dwitch/db-client": ["packages/db-client/src"],
    "@dwitch/errors": ["packages/errors/src"],
    "@validators/*": ["src/validators/*"]
  },
  "include": ["src", "../channels/src/controllers/subcriber-channel.controller.ts", "../channels/src/repositories/subscriber.repository.ts", "../channels/src/services/subscriber.service.ts", "../channels/src/validators/subcribe.validator.ts"],
  "exclude": ["dist"],
  "files": ["types/fastify.d.ts"]
}
